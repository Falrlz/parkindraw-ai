# ParkinDraw AI Environment Variables Template

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=parkindraw-resnet18

# Model / Data Storage Paths
DATA_DIR=ml/data
ARTIFACTS_DIR=ml/artifacts
